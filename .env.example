# Netlify Functions (quote form → Resend). Copy to .env for local netlify dev.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=A.S Painting Contractors <quotes@as-painting.co.uk>
RESEND_TO=info@aspainting.co.uk
RESEND_BCC=ben@dotwall.co.uk

# Password for /.netlify/functions/submissions-inbox (weekly digest links here too)
SUBMISSIONS_PASSWORD=choose-a-strong-password

# Optional: override weekly digest recipient (defaults to RESEND_TO)
# DIGEST_TO=info@aspainting.co.uk

# Optional Blobs fallback for scheduled jobs / local testing
# SITE_ID is set automatically on Netlify; NETLIFY_API_TOKEN is a personal access token with blobs access
# NETLIFY_API_TOKEN=
# SITE_ID=
