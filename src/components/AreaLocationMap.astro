---
import 'leaflet/dist/leaflet.css';
import type { AreaAccent } from '~/data/areas';

type MapPoint = { name: string; lat: number; lng: number };

interface Props {
  name: string;
  lat: number;
  lng: number;
  accent?: AreaAccent;
  mapId?: string;
  /** Several pins (map fits them all); replaces the single lat/lng pin */
  points?: MapPoint[];
}

const { name, lat, lng, accent = 'red', mapId = 'area-location-map', points } = Astro.props;

const mapPoints = points ?? [{ name, lat, lng }];
const ariaLabel = points
  ? `Map of ${name} towns we cover`
  : `Map showing ${name} in Leicestershire`;
---
<div class="area-location-map-wrap">
  <div
    id={mapId}
    class="area-location-map"
    role="img"
    aria-label={ariaLabel}
    data-points={JSON.stringify(mapPoints)}
    data-accent={accent}
  ></div>
  <p class="area-location-map__credit">
    <a href="/areas">All areas</a>
    <span aria-hidden="true"> · </span>
    Map &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a>
  </p>
</div>

<script>
  import L from 'leaflet';

  function initAreaLocationMaps() {
    document.querySelectorAll<HTMLElement>('.area-location-map[data-points]').forEach((el) => {
      if (el.dataset.mapReady || !el.dataset.points) return;

      const points = JSON.parse(el.dataset.points) as { name: string; lat: number; lng: number }[];
      if (!points.length) return;
      const accent = el.dataset.accent ?? 'red';

      const root = getComputedStyle(document.documentElement);
      const fill = root.getPropertyValue(`--c-${accent}`).trim() || '#d4262c';
      const stroke =
        accent === 'yellow' || accent === 'lime' ? '#0e0e10' : '#ffffff';

      const map = L.map(el, {
        scrollWheelZoom: false,
        zoomControl: true,
        attributionControl: true,
      });

      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 16,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      const markers = points.map(({ name, lat, lng }) =>
        L.circleMarker([lat, lng], {
          radius: points.length > 1 ? 9 : 12,
          fillColor: fill,
          color: stroke,
          weight: points.length > 1 ? 2.5 : 3,
          fillOpacity: 1,
        })
          .addTo(map)
          .bindPopup(`<strong>${name}</strong>`),
      );

      if (points.length === 1) {
        map.setView([points[0].lat, points[0].lng], 12);
        markers[0].openPopup();
      } else {
        map.fitBounds(L.latLngBounds(points.map((p) => [p.lat, p.lng])).pad(0.15));
        markers.forEach((marker) => {
          marker.on('mouseover', () => marker.openPopup());
          marker.on('mouseout', () => marker.closePopup());
        });
      }

      el.dataset.mapReady = 'true';

      const refresh = () => map.invalidateSize();
      requestAnimationFrame(refresh);
      setTimeout(refresh, 200);
      window.addEventListener('load', refresh, { once: true });
      new ResizeObserver(refresh).observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAreaLocationMaps, { once: true });
  } else {
    initAreaLocationMaps();
  }
</script>

<style>
  .area-location-map-wrap {
    width: 100%;
    min-width: 0;
  }
  .area-location-map {
    width: 100%;
    height: clamp(280px, 36vw, 380px);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(14, 14, 16, 0.1);
    box-shadow: var(--shadow-md);
    background: #e8e8e6;
    z-index: 0;
  }
  .area-location-map__credit {
    margin: 8px 0 0;
    font-size: 11px;
    color: var(--c-stone);
    text-align: right;
  }
  .area-location-map__credit a {
    color: var(--c-graphite);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
