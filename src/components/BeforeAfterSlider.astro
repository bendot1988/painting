---
interface Props {
  beforeSrc: string;
  beforeAlt: string;
  afterSrc: string;
  afterAlt: string;
}

const { beforeSrc, beforeAlt, afterSrc, afterAlt } = Astro.props;
---
<div class="ba-slider reveal" data-ba-slider>
  <div class="ba-slider__frame" data-ba-frame>
    <img
      class="ba-slider__img ba-slider__img--before"
      src={beforeSrc}
      alt={beforeAlt}
      width="960"
      height="1280"
    />
    <div class="ba-slider__after" data-ba-after style="--pos: 50%;">
      <img
        class="ba-slider__img ba-slider__img--after"
        src={afterSrc}
        alt={afterAlt}
        width="960"
        height="1280"
        fetchpriority="high"
      />
    </div>
    <div class="ba-slider__handle" data-ba-handle style="--pos: 50%;" aria-hidden="true">
      <span class="ba-slider__knob">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M8 12 4 8v8zm12-4v8l-4-4z" />
        </svg>
      </span>
    </div>
    <span class="ba-slider__label ba-slider__label--after">After</span>
    <span class="ba-slider__label ba-slider__label--before">Before</span>
  </div>
  <label class="visually-hidden" for="ba-range">Drag to compare before and after</label>
  <input
    id="ba-range"
    class="ba-slider__range"
    data-ba-range
    type="range"
    min="0"
    max="100"
    value="50"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-label="Compare before and after photos"
  />
</div>

<script>
  function initBeforeAfterSliders() {
    document.querySelectorAll('[data-ba-slider]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.baReady === '1') return;
      root.dataset.baReady = '1';

      const frame = root.querySelector('[data-ba-frame]');
      const after = root.querySelector('[data-ba-after]');
      const handle = root.querySelector('[data-ba-handle]');
      const range = root.querySelector('[data-ba-range]');
      if (
        !(frame instanceof HTMLElement) ||
        !(after instanceof HTMLElement) ||
        !(handle instanceof HTMLElement) ||
        !(range instanceof HTMLInputElement)
      ) {
        return;
      }

      const setPos = (value: number) => {
        const pos = Math.min(100, Math.max(0, value));
        const css = `${pos}%`;
        after.style.setProperty('--pos', css);
        handle.style.setProperty('--pos', css);
        range.value = String(Math.round(pos));
        range.setAttribute('aria-valuenow', String(Math.round(pos)));
      };

      const posFromClientX = (clientX: number) => {
        const rect = frame.getBoundingClientRect();
        if (rect.width <= 0) return 50;
        return ((clientX - rect.left) / rect.width) * 100;
      };

      range.addEventListener('input', () => setPos(Number(range.value)));

      let dragging = false;
      frame.addEventListener('pointerdown', (event: PointerEvent) => {
        dragging = true;
        frame.setPointerCapture?.(event.pointerId);
        setPos(posFromClientX(event.clientX));
      });
      frame.addEventListener('pointermove', (event: PointerEvent) => {
        if (!dragging) return;
        setPos(posFromClientX(event.clientX));
      });
      const stop = () => {
        dragging = false;
      };
      frame.addEventListener('pointerup', stop);
      frame.addEventListener('pointercancel', stop);
    });
  }

  initBeforeAfterSliders();
  document.addEventListener('astro:page-load', initBeforeAfterSliders);
</script>

<style>
  .ba-slider {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-md);
    max-width: 920px;
    margin: 0 auto;
    touch-action: none;
    user-select: none;
  }
  .ba-slider__frame {
    position: relative;
    aspect-ratio: 3 / 4;
    max-height: min(78vh, 860px);
    cursor: ew-resize;
    background: #e8e8e6;
  }
  .ba-slider__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }
  .ba-slider__img--before {
    position: absolute;
    inset: 0;
  }
  .ba-slider__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0);
  }
  .ba-slider__img--after {
    position: absolute;
    inset: 0;
  }
  .ba-slider__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    width: 2px;
    background: #fff;
    transform: translateX(-50%);
    z-index: 2;
    pointer-events: none;
  }
  .ba-slider__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: var(--c-ink, #0e0e10);
    display: grid;
    place-items: center;
    box-shadow: 0 6px 18px rgba(14, 14, 16, 0.28);
  }
  .ba-slider__label {
    position: absolute;
    bottom: 14px;
    z-index: 3;
    margin: 0;
    padding: 6px 11px;
    border-radius: 6px;
    background: rgba(14, 14, 16, 0.82);
    color: #fff;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 1.2;
    pointer-events: none;
  }
  .ba-slider__label--after {
    left: 14px;
  }
  .ba-slider__label--before {
    right: 14px;
  }
  .ba-slider__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    z-index: 4;
  }

  @media (max-width: 640px) {
    .ba-slider__frame {
      max-height: min(70vh, 640px);
    }
    .ba-slider__knob {
      width: 40px;
      height: 40px;
    }
  }
</style>
