---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import {
  leaveAReviewHref,
  leaveAReviewPageDescription,
  leaveAReviewPageTitle,
  reviewPlatforms,
} from '~/data/leave-a-review';
---
<Layout title={leaveAReviewPageTitle} description={leaveAReviewPageDescription} canonical={leaveAReviewHref}>
  <Header />
  <main id="main" class="leave-review">
    <section class="leave-review__hero" aria-labelledby="leave-review-heading">
      <div class="container leave-review__inner">
        <span class="eyebrow">Customer feedback</span>
        <h1 id="leave-review-heading" class="display h1">
          We'd value your <span class="painted-word painted-word--yellow">feedback.</span>
        </h1>
        <p class="lead leave-review__intro">
          Thank you for choosing A.S Painting Contractors. Please pick whichever review platform
          you prefer below.
        </p>

        <ul class="leave-review__list">
          {reviewPlatforms.map((platform) => (
            <li>
              <a
                class:list={['leave-review__btn', `leave-review__btn--${platform.id}`]}
                href={platform.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="leave-review__symbol" aria-hidden="true">
                  <img src={platform.logoSrc} alt="" width="48" height="48" />
                </span>
                <span class="leave-review__label">{platform.label}</span>
                <span class="leave-review__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="leave-review__note">Customers only need to leave a review on one platform.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .leave-review {
    padding-top: calc(38px + 50px);
    padding-bottom: clamp(72px, 9vw, 120px);
  }
  .leave-review__inner {
    max-width: 640px;
  }
  .leave-review__intro {
    margin-top: 16px;
    max-width: 42ch;
  }
  .leave-review__list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .leave-review__btn {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 16px;
    text-decoration: none;
    font-weight: 750;
    font-size: clamp(16px, 2.4vw, 20px);
    box-shadow: var(--shadow-sm);
    border: 1px solid transparent;
    transition: transform 0.18s var(--ease), filter 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .leave-review__btn:hover {
    filter: brightness(1.04);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .leave-review__btn:focus-visible {
    outline: 3px solid var(--c-yellow);
    outline-offset: 3px;
  }
  .leave-review__btn--google {
    background: #fff;
    color: var(--c-ink);
    border-color: rgba(14, 14, 16, 0.12);
  }
  .leave-review__btn--trustpilot {
    background: #00b67a;
    color: #fff;
  }
  .leave-review__btn--yell {
    background: #ffe600;
    color: #111;
  }
  .leave-review__symbol {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #fff;
    display: grid;
    place-items: center;
    padding: 8px;
    box-shadow: inset 0 0 0 1px rgba(14, 14, 16, 0.06);
  }
  .leave-review__btn--google .leave-review__symbol {
    box-shadow: none;
    padding: 4px;
  }
  .leave-review__btn--yell .leave-review__symbol {
    padding: 0;
    background: transparent;
    box-shadow: none;
  }
  .leave-review__symbol img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .leave-review__label {
    flex: 1;
    text-align: left;
    line-height: 1.25;
  }
  .leave-review__arrow {
    font-size: 22px;
    opacity: 0.85;
  }
  .leave-review__note {
    margin: 24px 0 0;
    padding: 14px 18px;
    border-radius: 14px;
    background: rgba(14, 14, 16, 0.04);
    color: var(--c-graphite);
    font-size: 14.5px;
    line-height: 1.5;
  }

  @media (max-width: 540px) {
    .leave-review__btn {
      padding: 14px 14px;
      gap: 12px;
    }
    .leave-review__symbol {
      width: 42px;
      height: 42px;
    }
  }
</style>
