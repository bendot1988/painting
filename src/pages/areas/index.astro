---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import AreasMap from '~/components/AreasMap.astro';
import {
  areas,
  areaAccent,
  areaListTitle,
} from '~/data/areas';
import { quotePageHref } from '~/data/contact';
import { cotswoldsHref, cotswoldsTownNames } from '~/data/cotswolds';

const pageTitle = 'Areas Covered | A.S Painting Contractors';
const pageDescription =
  'Painting and decorating across Leicester, Leicestershire and the Cotswolds. Find your town or village and see how we can help with commercial and domestic work.';
---
<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main id="main" class="areas-page">
    <section class="areas-page__hero" aria-labelledby="areas-heading">
      <div class="container">
        <span class="eyebrow">Where we work</span>
        <h1 id="areas-heading" class="display h1">
          Areas <span class="painted-word painted-word--lime">covered.</span>
        </h1>
        <p class="lead areas-page__intro">
          Based in Leicester, we work across the county and the
          <a href={cotswoldsHref}>Cotswolds</a> for homeowners, landlords and
          businesses. Select your area below for local information, or
          <a href="/contact">get in touch</a> if you are not sure we cover you.
        </p>
      </div>
    </section>

    <AreasMap />

    <section class="areas-page__cots" aria-labelledby="areas-cots-heading">
      <div class="container">
        <a class="areas-page__cots-card reveal" href={cotswoldsHref}>
          <div class="areas-page__cots-copy">
            <span class="areas-page__cots-eyebrow">Now covering</span>
            <h2 id="areas-cots-heading" class="display">The Cotswolds</h2>
            <p>
              Domestic and commercial painting for period homes, larger properties,
              hotels, pubs and holiday lets, including exterior decorating and
              ongoing maintenance.
            </p>
            <span class="areas-page__cots-cta">Cotswolds painting &amp; decorating <span class="arrow">→</span></span>
          </div>
          <ul class="areas-page__cots-towns" aria-label="Cotswold towns we cover">
            {cotswoldsTownNames.map((town) => <li>{town}</li>)}
          </ul>
        </a>
      </div>
    </section>

    <section class="areas-page__list" aria-label="Towns and villages we cover">
      <div class="container">
        <ul class="areas-page__grid">
          {areas.map((area, i) => (
            <li class="reveal" style={`--i:${i % 12}`}>
              <a
                class={`areas-page__card areas-page__card--${areaAccent(i)}`}
                href={`/areas/${area.slug}`}
              >
                <span class="areas-page__card-dot" aria-hidden="true"></span>
                <span class="areas-page__card-title">{areaListTitle(area.name)}</span>
                <span class="areas-page__card-cta">View area <span class="arrow">→</span></span>
              </a>
            </li>
          ))}
        </ul>

        <div class="areas-page__cta reveal">
          <p>Not listed? We still travel across Leicestershire, the East Midlands and the Cotswolds. Just ask.</p>
          <a class="btn" href={quotePageHref}>Request a quote <span class="arrow">→</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .areas-page {
    --page-stack-gap: 50px;
  }
  .areas-page__hero {
    padding-top: calc(38px + var(--page-stack-gap));
    padding-bottom: 0;
  }
  .areas-page__hero h1 {
    margin-top: 14px;
    max-width: 12ch;
  }
  .areas-page__intro {
    max-width: 52ch;
    margin-top: 16px;
  }
  .areas-page__intro a {
    color: var(--c-red);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .areas-page__cots {
    padding: 0 0 28px;
  }
  .areas-page__cots-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 28px;
    align-items: center;
    padding: clamp(24px, 3.5vw, 40px);
    border-radius: 22px;
    background: var(--c-ink);
    color: #fff;
    text-decoration: none;
    border-top: 6px solid var(--c-lime);
    box-shadow: var(--shadow-md);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .areas-page__cots-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg, var(--shadow-md));
  }
  .areas-page__cots-eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-lime);
  }
  .areas-page__cots-copy h2 {
    margin: 8px 0 10px;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.05;
    color: #fff;
  }
  .areas-page__cots-copy p {
    margin: 0 0 18px;
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.8);
    font-size: 16px;
    line-height: 1.55;
  }
  .areas-page__cots-cta {
    font-weight: 700;
    color: var(--c-lime);
  }
  .areas-page__cots-towns {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .areas-page__cots-towns li {
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 14px;
    font-weight: 600;
  }

  .areas-page__list {
    padding: 0 0 clamp(72px, 9vw, 120px);
  }
  .areas-page__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .areas-page__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 100%;
    padding: 20px 22px;
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    border-top: 4px solid var(--accent, var(--c-red));
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
    transition-delay: calc(var(--i) * 40ms);
  }
  .areas-page__card--red    { --accent: var(--c-red); }
  .areas-page__card--yellow { --accent: var(--c-yellow); }
  .areas-page__card--lime   { --accent: var(--c-lime); }
  .areas-page__card--pink   { --accent: var(--c-pink); }
  .areas-page__card--blue   { --accent: var(--c-blue); }
  .areas-page__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .areas-page__card-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent, var(--c-red));
  }
  .areas-page__card-title {
    font-family: var(--font-display);
    font-size: clamp(16px, 1.8vw, 18px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--c-ink);
    flex: 1;
  }
  .areas-page__card-cta {
    font-size: 13px;
    font-weight: 600;
    color: var(--c-stone);
  }
  .areas-page__card:hover .areas-page__card-cta {
    color: var(--c-red);
  }

  .areas-page__cta {
    margin-top: 48px;
    padding: 28px 24px;
    text-align: center;
    border-radius: 18px;
    background: var(--bg-alt);
    border: 1px solid rgba(14, 14, 16, 0.08);
  }
  .areas-page__cta p {
    margin: 0 0 18px;
    max-width: 42ch;
    margin-inline: auto;
    color: var(--c-graphite);
    font-size: 16px;
    line-height: 1.55;
  }

  @media (max-width: 980px) {
    .areas-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .areas-page__cots-card {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 540px) {
    .areas-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
