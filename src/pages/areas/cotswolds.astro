---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import AreaLocationMap from '~/components/AreaLocationMap.astro';
import { quotePageHref } from '~/data/contact';
import {
  cotswoldsFaqs,
  cotswoldsHref,
  cotswoldsPageDescription,
  cotswoldsPageTitle,
  cotswoldsTowns,
} from '~/data/cotswolds';
import { projectHref } from '~/data/projects';
import { buildCotswoldsPageJsonLd } from '~/utils/area-json-ld';

const jsonLd = buildCotswoldsPageJsonLd(cotswoldsFaqs);

/** Each Cotswolds .jpg has a full-size .webp and a -640.webp for phones. */
const webp = (jpg: string, width: number) => {
  const base = jpg.replace(/\.jpg$/, '');
  return { src: `${base}.webp`, srcset: `${base}-640.webp 640w, ${base}.webp ${width}w` };
};
const hero = webp('/images/cotswolds/domestic-stone-cottage-roses.jpg', 1137);
const kitchen = webp('/images/cotswolds/domestic-kitchen-sage-island.jpg', 1117);
const shopfront = webp('/images/cotswolds/commercial-shopfront-sage-green.jpg', 1008);
const farmhouseHref = projectHref('200-year-old-farmhouse-full-repaint');
const sage = '#5f7252';

const specialisms = [
  {
    title: 'Period & listed buildings',
    desc: 'Cotswold stone, lime render, sash windows and old timber need the right prep and breathable paint systems. We take the time to do it properly.',
  },
  {
    title: 'Luxury homes & estates',
    desc: 'Manor houses, luxury homes, farmhouses, barn conversions and outbuildings painted inside and out, with one crew and one programme from start to finish.',
  },
  {
    title: 'Exterior decorating',
    desc: 'Windows, doors, fascias, soffits, gates, railings and garden joinery. IPAF-qualified operatives for cherry pickers on gables and tall elevations.',
  },
  {
    title: 'Maintenance work',
    desc: 'Planned repainting and touch-ups for holiday lets, rental homes and commercial premises, so properties stay guest-ready all year.',
  },
];

const domesticPoints = [
  'Full interior and exterior repaints',
  'Period features, sash windows and panelled doors',
  'Kitchens, woodwork, staircases and skirting',
  'Barn conversions, annexes and outbuildings',
  'Dustless sanding for cleaner prep at home',
];

const commercialPoints = [
  'Hotels, inns, pubs and restaurants',
  'Holiday lets and guest houses between bookings',
  'Shops, galleries and offices',
  'Schools, churches and community buildings',
  'Out-of-hours and weekend working available',
];

const steps = [
  {
    title: 'Send photos or call',
    desc: 'Tell us about the property. Phone and photo quotes are free, and we reply the same day.',
  },
  {
    title: 'Fixed-price quote',
    desc: 'A clear, itemised price with products and timings before work starts. No surprises later.',
  },
  {
    title: 'Planned programme',
    desc: 'We agree dates around you, your guests or your trading hours, then protect, prep and paint.',
  },
  {
    title: 'Walk-round & sign-off',
    desc: 'We check every area with you before we leave, and the site is left clean and tidy.',
  },
];

const propertyTypes = [
  {
    src: '/images/cotswolds/domestic-living-room-inglenook.jpg',
    alt: 'Cotswold cottage living room with exposed stone inglenook fireplace and oak beams',
    label: 'Cottage interiors',
    width: 1084,
    height: 735,
  },
  {
    src: '/images/cotswolds/domestic-beamed-bedroom.jpg',
    alt: 'Beamed bedroom in a stone farmhouse with soft neutral walls and a window seat',
    label: 'Period bedrooms',
    width: 1142,
    height: 769,
  },
  {
    src: '/images/cotswolds/domestic-stone-cottage-garden-wall.jpg',
    alt: 'Honey-coloured stone cottage with sage green front door behind a dry stone wall',
    label: 'Stone cottage exteriors',
    width: 1154,
    height: 776,
  },
  {
    src: '/images/cotswolds/commercial-stone-cafe-orangery.jpg',
    alt: 'Stone-built café with a glazed orangery and outdoor seating on a gravel terrace',
    label: 'Cafés & hospitality',
    width: 1128,
    height: 806,
  },
];

const realWork = [
  {
    src: '/images/domestic-exterior-farmhouse-full-repaint-front.jpeg',
    alt: '200-year-old red brick farmhouse with freshly painted white sash windows, entrance canopy and door surround',
  },
  {
    src: '/images/domestic-exterior-farmhouse-full-repaint-courtyard.jpeg',
    alt: 'Period farmhouse courtyard with newly painted red doors and white sash windows',
  },
  {
    src: '/images/domestic-exterior-period-white-house-front.jpeg',
    alt: 'Period detached house with freshly painted white render and dark window frames',
  },
  {
    src: '/images/commercial-exterior-church-leicester-studded-arched-doors.jpeg',
    alt: 'Studded arched church doors repainted with a deep, durable finish',
  },
];
---
<Layout title={cotswoldsPageTitle} description={cotswoldsPageDescription} canonical={cotswoldsHref} jsonLd={jsonLd}>
  <Header />
  <main id="main" class="cots-page">
    <section class="cots-page__hero" aria-labelledby="cots-heading">
      <div class="container">
        <nav class="cots-page__crumb" aria-label="Breadcrumb">
          <a href="/areas">Areas covered</a>
          <span aria-hidden="true">/</span>
          <span>Cotswolds</span>
        </nav>
        <div class="cots-page__hero-layout">
          <div class="cots-page__hero-head">
            <span class="eyebrow cots-page__eyebrow">Cotswolds · Gloucestershire, Oxfordshire &amp; Worcestershire</span>
            <h1 id="cots-heading" class="display h1">
              Painters &amp; decorators in the <span class="painted-word cots-page__painted">Cotswolds.</span>
            </h1>
            <p class="lead cots-page__intro">
              Painters and decorators for luxury homes, period properties and commercial
              contracts across the Cotswolds, from Moreton-in-Marsh and Chipping Campden to
              Broadway, Stow-on-the-Wold, Bourton-on-the-Water and Burford.
            </p>
            <p class="cots-page__intro-sub">
              We're a 5-star rated team with 25+ years of experience, based in Leicester and
              working across the Cotswolds. Fixed-price quotes, tidy crews and finishes that
              suit the character of your building.
            </p>
            <div class="cots-page__actions">
              <a class="btn" href={quotePageHref}>Get a quote <span class="arrow">→</span></a>
              <a class="btn btn--ghost" href="#cots-towns">Towns we cover <span class="arrow">→</span></a>
            </div>
            <figure class="cots-page__badge">
              <img
                src="/images/cotswolds/proud-to-work-badge.webp"
                srcset="/images/cotswolds/proud-to-work-badge-320.webp 320w, /images/cotswolds/proud-to-work-badge.webp 640w"
                sizes="160px"
                alt="A.S Painting Contractors — proud to work in the Cotswolds. Commercial, residential, schools and specialist coatings."
                width="640"
                height="639"
                loading="lazy"
              />
            </figure>
          </div>
          <figure class="cots-page__hero-figure">
            <img
              src={hero.src}
              srcset={hero.srcset}
              sizes="(max-width: 900px) calc(100vw - 40px), 46vw"
              alt="Honey-coloured Cotswold stone cottage with climbing roses behind a dry stone wall"
              width="1137"
              height="706"
              fetchpriority="high"
            />
            <figcaption class="cots-page__hero-card">
              <span class="cots-page__hero-card-label">Domestic &amp; commercial</span>
              <span class="cots-page__hero-card-text">Moreton · Stow · Broadway · Burford · Chipping Campden</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <div class="cots-page__wall" aria-hidden="true"></div>

    <section class="cots-page__band" aria-labelledby="cots-specialisms-heading">
      <div class="container">
        <h2 id="cots-specialisms-heading" class="cots-page__section-title">
          Built for Cotswold properties
        </h2>
        <p class="cots-page__section-lead">
          Honey-coloured stone, centuries-old joinery and buildings that face the weather on
          every side. Cotswold properties reward careful preparation and the right products.
        </p>
        <ul class="cots-page__specialisms">
          {specialisms.map((item, i) => (
            <li class="cots-page__specialism reveal" style={`--i:${i}`}>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </li>
          ))}
        </ul>
        <p class="cots-page__proof">
          See how we approach older buildings in our
          <a href={farmhouseHref}>200-year-old farmhouse full repaint</a>.
        </p>
      </div>
    </section>

    <section class="cots-page__services" aria-label="Domestic and commercial painting in the Cotswolds">
      <div class="container">
        <div class="cots-page__services-grid">
          <article class="cots-page__panel reveal">
            <figure class="cots-page__panel-media">
              <img
                src={kitchen.src}
                srcset={kitchen.srcset}
                sizes="(max-width: 768px) calc(100vw - 40px), 50vw"
                alt="Farmhouse kitchen with sage green painted island and cabinets under oak beams"
                width="1117"
                height="753"
                loading="lazy"
              />
            </figure>
            <div class="cots-page__panel-body">
              <span class="cots-page__panel-tag">Domestic</span>
              <h2 class="display h3">Home painting in the Cotswolds</h2>
              <p>
                From a stone cottage in Northleach to a large family house outside Chipping Norton,
                we decorate room by room or whole properties, inside and out. Furniture and floors are
                protected, and we leave each space usable at the end of the day where possible.
              </p>
              <ul>
                {domesticPoints.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a href="/domestic">Domestic painting services <span class="arrow">→</span></a>
            </div>
          </article>

          <article class="cots-page__panel cots-page__panel--commercial reveal">
            <figure class="cots-page__panel-media">
              <img
                src={shopfront.src}
                srcset={shopfront.srcset}
                sizes="(max-width: 768px) calc(100vw - 40px), 50vw"
                alt="Sage green painted timber shopfront set into a Cotswold stone building"
                width="1008"
                height="754"
                loading="lazy"
              />
            </figure>
            <div class="cots-page__panel-body">
              <span class="cots-page__panel-tag">Commercial</span>
              <h2 class="display h3">Commercial painting in the Cotswolds</h2>
              <p>
                Hospitality, retail and holiday lets depend on first impressions. As commercial
                painting contractors, we repaint interiors and exteriors around bookings and
                trading hours, with RAMS, method statements and tidy working as standard.
              </p>
              <ul>
                {commercialPoints.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a href="/commercial">Commercial painting services <span class="arrow">→</span></a>
            </div>
          </article>
        </div>
        <p class="cots-page__services-more">
          Ongoing upkeep? See our <a href="/maintenance-plans/">maintenance plans</a>.
          Need stonework or paving cleaned first? We also offer <a href="/jet-cleaning/">jet cleaning</a>.
        </p>
      </div>
    </section>

    <section class="cots-page__types" aria-labelledby="cots-types-heading">
      <div class="container">
        <h2 id="cots-types-heading" class="cots-page__section-title">Cotswold homes &amp; businesses</h2>
        <p class="cots-page__section-lead">
          From cottage interiors with exposed stone and beams to cafés, shops and holiday lets,
          these are the kinds of Cotswold properties we look after.
        </p>
        <ul class="cots-page__types-grid reveal">
          {propertyTypes.map((img, i) => (
            <li class="cots-page__type" style={`--i:${i}`}>
              <figure>
                <img
                  {...webp(img.src, img.width)}
                  sizes="(max-width: 1024px) 50vw, 25vw"
                  alt={img.alt}
                  loading="lazy"
                  width={img.width}
                  height={img.height}
                />
                <figcaption>{img.label}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="cots-page__types-note">Images are illustrative.</p>
      </div>
    </section>

    <section id="cots-towns" class="cots-page__towns" aria-labelledby="cots-towns-heading">
      <div class="container">
        <h2 id="cots-towns-heading" class="cots-page__section-title">Cotswold towns we cover</h2>
        <p class="cots-page__section-lead">
          We cover these towns and the villages around them, including the Slaughters, Blockley,
          Snowshill, Kingham and Bledington. Not sure if we reach you? Just ask.
        </p>
        <div class="cots-page__towns-layout">
          <div class="cots-page__towns-map">
            <AreaLocationMap
              name="the Cotswolds"
              lat={cotswoldsTowns[0].lat}
              lng={cotswoldsTowns[0].lng}
              mapId="cotswolds-map"
              points={cotswoldsTowns}
              color={sage}
            />
          </div>
          <ul class="cots-page__town-grid">
            {cotswoldsTowns.map((town, i) => (
              <li class="cots-page__town reveal" style={`--i:${i}`}>
                <h3>Painters &amp; decorators in {town.name}</h3>
                <p>{town.note}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="cots-page__gallery" aria-labelledby="cots-gallery-heading">
      <div class="container">
        <h2 id="cots-gallery-heading" class="cots-page__section-title">Our period &amp; exterior work</h2>
        <p class="cots-page__section-lead">
          Real projects completed by our team, including a
          <a href={farmhouseHref}>200-year-old farmhouse full repaint</a>.
        </p>
        <ul class="cots-page__gallery-grid reveal">
          {realWork.map((img, i) => (
            <li class="cots-page__gallery-item" style={`--i:${i}`}>
              <figure>
                <img src={img.src} alt={img.alt} loading="lazy" width="640" height="480" />
              </figure>
            </li>
          ))}
        </ul>
        <p class="cots-page__gallery-more">
          <a href="/work">View all our work <span class="arrow">→</span></a>
        </p>
      </div>
    </section>

    <section class="cots-page__process" aria-labelledby="cots-process-heading">
      <div class="container">
        <h2 id="cots-process-heading" class="cots-page__section-title">How it works</h2>
        <ol class="cots-page__steps">
          {steps.map((step, i) => (
            <li class="cots-page__step reveal" style={`--i:${i}`}>
              <span class="cots-page__step-num" aria-hidden="true">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </li>
          ))}
        </ol>
        <p class="cots-page__services-more">
          More detail in <a href="/how-we-work/">how we work</a>.
        </p>
      </div>
    </section>

    <section class="cots-page__faqs" aria-labelledby="cots-faq-heading">
      <div class="container">
        <h2 id="cots-faq-heading" class="cots-page__section-title">
          Questions about painting in the Cotswolds
        </h2>
        <div class="cots-page__faq-list reveal">
          {cotswoldsFaqs.map((item) => (
            <details class="cots-page__faq">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cots-page__cta-band" aria-label="Get a quote">
      <div class="container">
        <div class="cots-page__cta-inner reveal">
          <h2 class="display h3">Need painters in the Cotswolds?</h2>
          <p>Same-day reply, fixed-price quotes, no hard sell. Call, message or send us a few photos.</p>
          <a class="btn" href={quotePageHref}>Get a quote <span class="arrow">→</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cots-page {
    --page-stack-gap: 50px;
    --cots-cream: #f8f2e6;
    --cots-stone: #ecdcbc;
    --cots-honey: #c4974f;
    --cots-honey-deep: #9c7334;
    --cots-sage: #5f7252;
    --cots-sage-deep: #435238;
    --cots-ink: #2e2a23;
    background: var(--cots-cream);
  }
  .cots-page .btn:not(.btn--ghost) {
    --btn-bg: var(--cots-sage);
    box-shadow: 0 6px 0 0 var(--cots-sage-deep), var(--shadow-sm);
  }
  .cots-page .btn:not(.btn--ghost):hover {
    box-shadow: 0 8px 0 0 var(--cots-sage-deep), var(--shadow-md);
  }
  .cots-page .btn:not(.btn--ghost):active {
    box-shadow: 0 2px 0 0 var(--cots-sage-deep);
  }
  .cots-page .btn--ghost {
    --btn-fg: var(--cots-ink);
    border-color: var(--cots-ink);
    box-shadow: 4px 4px 0 0 var(--cots-honey);
  }
  .cots-page .btn--ghost:hover {
    background: var(--cots-ink);
    color: var(--cots-cream);
    box-shadow: 6px 6px 0 0 var(--cots-honey);
  }

  .cots-page__hero {
    padding-top: calc(38px + var(--page-stack-gap));
    padding-bottom: clamp(48px, 6vw, 72px);
  }
  .cots-page__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--c-stone);
  }
  .cots-page__crumb a {
    color: var(--cots-sage-deep);
    text-decoration: none;
  }
  .cots-page__crumb a:hover {
    text-decoration: underline;
  }
  .cots-page__eyebrow {
    color: #7a5826;
  }
  .cots-page__painted::after {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 60' preserveAspectRatio='none'><path d='M5 35 C 80 10, 200 50, 290 28 S 480 12, 595 30 L 590 50 C 470 30, 320 60, 200 50 S 60 40, 8 55 Z' fill='%23d9b26f'/></svg>");
  }
  .cots-page__hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 46%);
    gap: clamp(28px, 4vw, 52px);
    align-items: center;
  }
  .cots-page__hero-head {
    min-width: 0;
  }
  .cots-page__hero-head h1 {
    margin-top: 14px;
    max-width: 15ch;
    color: var(--cots-ink);
    isolation: isolate;
  }
  .cots-page__intro {
    max-width: 54ch;
    margin-top: 18px;
  }
  .cots-page__intro-sub {
    max-width: 54ch;
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-graphite);
  }
  .cots-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .cots-page__badge {
    margin: 28px 0 0;
    width: 160px;
  }
  .cots-page__badge img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cots-page__hero-figure {
    position: relative;
    min-width: 0;
    margin: 0 0 28px;
  }
  .cots-page__hero-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 24px;
    border: 6px solid #fff;
    box-shadow: var(--shadow-md);
  }
  .cots-page__hero-card {
    position: absolute;
    left: clamp(-12px, -1.5vw, 0px);
    bottom: -24px;
    max-width: min(86%, 340px);
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--cots-sage);
    color: #fff;
    box-shadow: var(--shadow-md);
  }
  .cots-page__hero-card-label {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cots-cream);
  }
  .cots-page__hero-card-text {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .cots-page__wall {
    height: 30px;
    background-color: var(--cots-stone);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='30'><g fill='%23dcc394' stroke='%23b48c4e' stroke-width='1.2'><rect x='1' y='1' width='30' height='8' rx='3'/><rect x='33' y='1' width='44' height='8' rx='3'/><rect x='79' y='1' width='22' height='8' rx='3'/><rect x='103' y='1' width='34' height='8' rx='3'/><rect x='139' y='1' width='20' height='8' rx='3'/><rect x='1' y='11' width='18' height='8' rx='3'/><rect x='21' y='11' width='38' height='8' rx='3'/><rect x='61' y='11' width='28' height='8' rx='3'/><rect x='91' y='11' width='42' height='8' rx='3'/><rect x='135' y='11' width='24' height='8' rx='3'/><rect x='1' y='21' width='36' height='8' rx='3'/><rect x='39' y='21' width='24' height='8' rx='3'/><rect x='65' y='21' width='40' height='8' rx='3'/><rect x='107' y='21' width='26' height='8' rx='3'/><rect x='135' y='21' width='24' height='8' rx='3'/></g></svg>");
    background-repeat: repeat-x;
    background-position: center;
  }

  .cots-page__section-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.5vw, 28px);
    font-weight: 700;
    margin: 0 0 12px;
    color: var(--cots-ink);
  }
  .cots-page__section-lead {
    margin: 0 0 24px;
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-graphite);
  }
  .cots-page__section-lead a,
  .cots-page__proof a,
  .cots-page__services-more a {
    color: var(--cots-sage-deep);
    font-weight: 700;
  }

  .cots-page__band {
    background: #fff;
    padding: clamp(48px, 6vw, 72px) 0;
  }
  .cots-page__specialisms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .cots-page__specialism {
    padding: 22px;
    border-radius: 16px;
    background: var(--cots-cream);
    border: 1px solid rgba(156, 115, 52, 0.18);
    border-top: 4px solid var(--cots-honey);
    transition-delay: calc(var(--i) * 50ms);
  }
  .cots-page__specialism:nth-child(even) {
    border-top-color: var(--cots-sage);
  }
  .cots-page__specialism h3 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--cots-ink);
  }
  .cots-page__specialism p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--c-graphite);
  }
